# Google Sheets Integration
# Follow the instructions in GOOGLE_SHEETS_SETUP.md to get your Web App URL
VITE_GOOGLE_SCRIPT_URL= https://script.google.com/macros/s/AKfycbzzQvZCijupTHiOJ-QgxKQr9gEoUMq1qvIhIDXnaicy7F7Kj5ykTWHxgaUbqnPDae37/exec

# YouTube Data API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Your YouTube Channel ID
# Find it at: https://www.youtube.com/account_advanced
VITE_YOUTUBE_CHANNEL_ID=your_channel_id_here

# OpenAI API Configuration (for Loopi AI Chatbot)
# Get your API key from: https://platform.openai.com/api-keys
# Note: The chatbot has intelligent fallback responses if API key is not provided
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration (for News Articles Persistence)
# Get these from your Supabase project settings: https://app.supabase.com
# 1. Create a new project at https://app.supabase.com
# 2. Go to Settings > API to find your URL and keys
# 3. Run the SQL migration in supabase-migration.sql to create the news_articles table
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
